# Copy to .env and adjust

# Root folder of the extracted OpenEar specimen (relative to repo root or absolute)
DATASET_ROOT=./Dataset
SPECIMEN_ID=zeta

# Where pipeline outputs (JSON, .glb meshes) are written
OUTPUT_DIR=./data

# Optional: 3D Slicer for reference statistics in `cochleahub validate` (stage 3)
# SLICER_EXE=C:/Users/<you>/AppData/Local/slicer.org/3D Slicer 5.12.4/Slicer.exe

# PostgreSQL (docker compose in infra/)
POSTGRES_USER=cochleahub
POSTGRES_PASSWORD=cochleahub
POSTGRES_DB=cochleahub
DATABASE_URL=postgresql+psycopg://cochleahub:cochleahub@localhost:5432/cochleahub

# Orthanc DICOMweb (docker compose in infra/)
ORTHANC_URL=http://localhost:8042
DICOMWEB_ROOT=http://localhost:8042/dicom-web
# DICOMweb base given to the browser: same-origin path proxied to Orthanc (never expose Orthanc)
DICOMWEB_PUBLIC_ROOT=/dicom-web
CORS_ORIGINS=["http://localhost:5173"]

# LLM assistant (stage 7, D20). LLM_BACKEND: claude | local.
# claude: Claude API for development (needs ANTHROPIC_API_KEY); set LLM_PROVIDER=bedrock to use
# Amazon Bedrock in AWS_REGION instead (AWS credentials, no Anthropic key; data stays in the
# AWS account). local: open-weight model on Ollama (Ollama Desktop, or
# docker compose --profile local-llm); same URL either way.
ANTHROPIC_API_KEY=
LLM_BACKEND=claude
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
BEDROCK_MODEL=anthropic.claude-opus-5-5
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=qwen3.5:4b
LOCAL_CONTEXT_TOKENS=8192

# Object storage for meshes (stage 4). Locally SeaweedFS (S3 API) from infra/; on AWS leave
# S3_ENDPOINT_URL empty and use real credentials (or an IAM role) instead of these.
AWS_REGION=eu-west-3
S3_ENDPOINT_URL=http://localhost:8333
S3_MESH_BUCKET=cochleahub-meshes
AWS_ACCESS_KEY_ID=cochleahub
AWS_SECRET_ACCESS_KEY=cochleahub-secret
