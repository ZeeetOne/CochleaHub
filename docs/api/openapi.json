          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "a": {
            "$ref": "#/components/schemas/CochleaValue"
          },
          "b": {
            "$ref": "#/components/schemas/CochleaValue"
          },
          "height": {
            "$ref": "#/components/schemas/CochleaValue"
          }
        },
        "type": "object",
        "required": [
          "provenance",
          "method",
          "a",
          "b",
          "height"
        ],
        "title": "Cochlea"
      },
      "CochleaValue": {
        "properties": {
          "value_mm": {
            "type": "number",
            "title": "Value Mm"
          },
          "reference": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReferenceRange"
              },
              {
                "type": "null"
              }
            ]
          },
          "in_range": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Range"
          }
        },
        "type": "object",
        "required": [
          "value_mm",
          "reference",
          "in_range"
        ],
        "title": "CochleaValue"
      },
      "ComparedValue": {
        "properties": {
          "specimen_id": {
            "type": "string",
            "title": "Specimen Id"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "provenance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Provenance"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "specimen_id",
          "value",
          "provenance"
        ],
        "title": "ComparedValue"
      },
      "Comparison": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "structure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Structure"
          },
          "reference": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReferenceRange"
              },
              {
                "type": "null"
              }
            ]
          },
          "values": {
            "items": {
              "$ref": "#/components/schemas/ComparedValue"
            },
            "type": "array",
            "title": "Values"
          }
        },
        "type": "object",
        "required": [
          "metric",
          "unit",
          "structure",
          "reference",
          "values"
        ],
        "title": "Comparison"
      },
      "DicomWeb": {
        "properties": {
          "dicomweb_root": {
            "type": "string",
            "title": "Dicomweb Root",
            "description": "Base URL for QIDO-RS / WADO-RS, as seen by a browser."
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/ImagingSeries"
            },
            "type": "array",
            "title": "Series"
          }
        },
        "type": "object",
        "required": [
          "dicomweb_root",
          "series"
        ],
        "title": "DicomWeb"
      },
      "Distance": {
        "properties": {
          "from_structure": {
            "type": "string",
            "title": "From Structure"
          },
          "to_structure": {
            "type": "string",
            "title": "To Structure"
          },
          "meaning": {
            "type": "string",
            "title": "Meaning"
          },
          "distance_mm": {
            "type": "number",
            "title": "Distance Mm"
          },
          "point_a_lps_mm": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Point A Lps Mm"
          },
          "point_b_lps_mm": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Point B Lps Mm"
          }
        },
        "type": "object",
        "required": [
          "from_structure",
          "to_structure",
          "meaning",
          "distance_mm",
          "point_a_lps_mm",
          "point_b_lps_mm"
        ],
        "title": "Distance"
      },
