        "properties": {
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "distances": {
            "items": {
              "$ref": "#/components/schemas/Distance"
            },
            "type": "array",
            "title": "Distances"
          }
        },
        "type": "object",
        "required": [
          "provenance",
          "distances"
        ],
        "title": "Distances"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
