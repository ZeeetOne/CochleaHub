            "title": "Status"
          },
          "pipeline_version": {
            "type": "string",
            "title": "Pipeline Version"
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks",
            "description": "Per dependency: 'ok' or the error message."
